#!/usr/bin/env sh
set -eu
GRADLE_VERSION=8.9
CACHE_DIR="${HOME}/.gradle/magicTupper-bootstrap"
GRADLE_HOME="$CACHE_DIR/gradle-$GRADLE_VERSION"
ZIP_FILE="$CACHE_DIR/gradle-$GRADLE_VERSION-bin.zip"
if [ ! -x "$GRADLE_HOME/bin/gradle" ]; then
  echo "[magicTupper] Preparing Gradle $GRADLE_VERSION for the first run..."
  mkdir -p "$CACHE_DIR"
  if [ ! -f "$ZIP_FILE" ]; then
    if command -v curl >/dev/null 2>&1; then curl -L "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$ZIP_FILE";
    else wget "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -O "$ZIP_FILE"; fi
  fi
  unzip -q -o "$ZIP_FILE" -d "$CACHE_DIR"
fi
exec "$GRADLE_HOME/bin/gradle" "$@"
